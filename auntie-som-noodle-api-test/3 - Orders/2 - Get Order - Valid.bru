meta {
  name: Get Order - Valid
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/orders/{{currentOrderId}}
  auth: none
}

tests {
  test("status should be 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("orderId should match the one we just created", function () {
    expect(res.body.orderId).to.equal(bru.getEnvVar("currentOrderId"));
  });

  test("status should still be 'created'", function () {
    expect(res.body.status).to.equal("created");
  });
}
