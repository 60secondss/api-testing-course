meta {
  name: Create Order - No Auth
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itemId": 1,
    "quantity": 1
  }
}

tests {
  test("status should be 401 when no token is sent", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
